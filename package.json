{
  "name": "janesis-core",
  "version": "0.1.0",
  "private": true,
  "description": "Janesis Core: Fastify modular monolith on Google Cloud Run",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "audit:deps": "npm audit --audit-level=high",
    "start": "node dist/bootstrap/container-entry.js"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
