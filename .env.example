# Initial Release — Runtime configuration. Copy this file to .env for local use. Never commit .env or real credentials.
# Core settings are active. Provider settings are commented out and use placeholders.
# Uncomment a provider group only when you have real values, and set every variable in that group.
#
# Production Infrastructure Note:
# Async jobs, event messaging, and scheduled tasks run natively on GCP Cloud Tasks, Cloud Pub/Sub,
# and Cloud Scheduler via Application Default Credentials (ADC). Telemetry and structured logging
# run natively via Pino, GCP Error Reporting, Cloud Trace, and Cloud Monitoring. Transactional
# email delivery runs via AWS SES. The QStash and Sentry keys below are retained for Initial Release
# runtime compatibility.
APP_ENV=development
PORT=8080
SHUTDOWN_TIMEOUT_MS=8000
# Database pool (engineering defaults and bounds, not Neon limits): max 1-20, idle 1000-300000 ms, connect 100-60000 ms
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# Clerk (authentication)
# CLERK_SECRET_KEY=<clerk-secret-key>
# CLERK_WEBHOOK_SECRET=<clerk-webhook-secret>

# Neon PostgreSQL
# DATABASE_URL=<database-url>

# Upstash Redis
# UPSTASH_REDIS_REST_URL=<redis-rest-url>
# UPSTASH_REDIS_REST_TOKEN=<redis-rest-token>

# Upstash QStash (Initial Release — production async workloads run on GCP Cloud Tasks, Pub/Sub & Cloud Scheduler)
# QSTASH_TOKEN=<qstash-token>
# QSTASH_CURRENT_SIGNING_KEY=<qstash-current-signing-key>
# QSTASH_NEXT_SIGNING_KEY=<qstash-next-signing-key>

# Cloudflare R2
# R2_ACCOUNT_ID=<r2-account-id>
# R2_ACCESS_KEY_ID=<r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# R2_BUCKET=<r2-bucket-name>

# Thirdweb
# THIRDWEB_SECRET_KEY=<thirdweb-secret-key>
# THIRDWEB_WEBHOOK_SECRET=<thirdweb-webhook-secret>

# Alchemy
# ALCHEMY_API_KEY=<alchemy-api-key>

# Sentry (Initial Release — production observability runs on GCP Error Reporting, Cloud Trace, Cloud Monitoring & Pino)
# SENTRY_DSN=<sentry-dsn>

# PostHog
# POSTHOG_API_KEY=<posthog-api-key>
# POSTHOG_HOST=<posthog-host>

# Cloudflare Turnstile
# TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# X API
# X_BEARER_TOKEN=<x-bearer-token>

# Telegram
# TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# TELEGRAM_WEBHOOK_SECRET=<telegram-webhook-secret>
